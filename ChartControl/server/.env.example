# QuantumTrade AI 백엔드 환경변수 예시
# 실제 값은 .env 또는 배포 환경의 시크릿 스토어에 넣는다. 저장소에 커밋하지 않는다.

NODE_ENV=development
PORT=8791
HOST=127.0.0.1
LOG_LEVEL=info

# 활성 거래소 어댑터
EXCHANGE=kucoin

# --- KuCoin 브로커 자격증명 -------------------------------------------------
# KuCoin 이 브로커 승인 후 발급하는 3종. 셋 다 있어야 리베이트 헤더가 붙는다.
# 하나라도 비면 파트너 서명을 생략한다 (부분 설정은 400201 Invalid KC-API-PARTNER-SIGN 유발).
KUCOIN_BROKER_PARTNER=
KUCOIN_BROKER_KEY=
KUCOIN_BROKER_NAME=

# --- 엔드포인트 (기본값 사용 권장) -----------------------------------------
KUCOIN_FUTURES_REST=https://api-futures.kucoin.com
KUCOIN_SPOT_REST=https://api.kucoin.com
KUCOIN_BROKER_REST=https://api-broker.kucoin.com

# --- 시세 튜닝 -------------------------------------------------------------
DEFAULT_SYMBOL=BTCUSDT
TICKER_REFRESH_MS=5000
CANDLE_TTL_MS=60000
KLINE_LIMIT=300

# --- WebSocket -----------------------------------------------------------
WS_HEARTBEAT_MS=20000
WS_MAX_CLIENTS=500

# 리버스 프록시(Nginx 등) 뒤에 둘 때만 true
TRUST_PROXY=false
