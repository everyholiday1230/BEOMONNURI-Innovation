####################################################################
# ChartControl — 프로덕션 환경변수 템플릿
#
# 사용법
#   cp .env.production.example .env.production
#   값을 채운 뒤:  node tools/launch-check.mjs --env .env.production
#
# ★★ 이 파일에는 값을 넣지 마십시오. 저장소에 들어가는 파일입니다.
#    실제 값은 .env.production (gitignore) 또는 배포 플랫폼의 시크릿에 둡니다.
#
# 표기
#   [필수]  없으면 서버가 뜨지 않거나, 뜨더라도 위험한 상태가 됩니다
#   [수익]  없으면 서비스는 동작하지만 우리 수익이 0원입니다
#   [선택]  기본값으로 충분합니다
####################################################################


# ─────────────────────────────────────────────────────────────────
# 1. 실행 환경
# ─────────────────────────────────────────────────────────────────

# [필수] ★★ 이 값이 'production' 이 아니면 아래 안전장치가 **전부 조용히 꺼집니다**:
#          · 서명키 검사        (개발용 키로 기동)
#          · DB 준비 검사       (SQLite 로 기동)
#          · 개발계정 검사      (테스트 계정이 남아 있어도 기동)
#        경고도 나오지 않습니다. 배포 파이프라인에서 이 값을 반드시 확인하십시오.
NODE_ENV=production

# [필수] 공개 주소. 이메일 링크와 CORS 기본값에 쓰입니다. 끝에 / 를 붙이지 마십시오.
PUBLIC_BASE_URL=

# [선택] 서버가 바인딩할 주소·포트. 리버스 프록시 뒤에 두는 것을 권장합니다.
API_HOST=0.0.0.0
API_PORT=8787


# ─────────────────────────────────────────────────────────────────
# 2. 보안 — 서명키와 쿠키
# ─────────────────────────────────────────────────────────────────

# [필수] CSRF 토큰 검증키.
#        생성:  openssl rand -hex 32
# ★★ 없으면 프로덕션 기동이 거부됩니다(env.ts fail-closed).
#    인스턴스마다 임시 키를 만들면 서버를 여러 대로 늘렸을 때
#    CSRF 검증이 **조용히** 깨집니다 — 그래서 명시적으로 요구합니다.
# ★ 'dev' 'test' 'secret' 'change' 'local' 같은 낱말이 들어가면 런칭 점검이 거부합니다.
# ★ 이 값이 바뀌면 열려 있던 폼 제출이 한 번 실패합니다. 배포 직후를 피하십시오.
AUTH_CSRF_KEY=

# ※ 세션에는 별도 서명키가 없습니다. 무작위 토큰을 발급하고 서버에는 해시만
#   저장하는 방식이므로(불투명 토큰) 키를 관리할 필요가 없습니다.

# [필수] 브라우저가 API 를 호출할 수 있는 오리진. 쉼표로 구분합니다.
# ★ localhost 나 http:// 가 남아 있으면 런칭 점검이 거부합니다 —
#   http 로 쿠키가 나가면 중간에서 세션을 가져갈 수 있습니다.
CORS_ALLOWED_ORIGINS=

# [선택] 쿠키 도메인. 서브도메인을 함께 쓸 때만 지정합니다.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_NAME=qt_session

# ★★ 절대 true 로 두지 마십시오. 세션 쿠키에서 Secure 플래그가 빠집니다.
#    로컬 개발에서만 씁니다. 프로덕션에서는 이 줄을 지우십시오.
# AUTH_COOKIE_INSECURE=false


# ─────────────────────────────────────────────────────────────────
# 3. 데이터베이스와 캐시
# ─────────────────────────────────────────────────────────────────

# [필수] PostgreSQL. 공지·티켓·리퍼럴·포인트·법적문서·자산이력이 여기에 있습니다.
# ★ 포인트는 부채이고 약관 동의는 법적 증거입니다. 휘발성 저장소에 둘 수 없습니다.
DATABASE_URL=

# [필수] Redis/Valkey. 분산 요청 제한에 씁니다.
# ★ 없으면 프로덕션 기동이 거부됩니다 — 프로세스 내 제한은 인스턴스가 늘면 우회됩니다.
REDIS_URL=

# [선택] WebSocket 게이트웨이용. 지정하지 않으면 REDIS_URL 을 씁니다.
GATEWAY_REDIS_URL=


# ─────────────────────────────────────────────────────────────────
# 4. 메일 — 없으면 비밀번호를 잊은 사용자가 영구히 잠깁니다
# ─────────────────────────────────────────────────────────────────

# [필수] ★★ 이 셋이 없으면 메일이 **메모리에만 쌓이고 아무에게도 도달하지 않습니다.**
#        서버는 경고 로그만 남기고 정상 동작합니다 — 그래서 놓치기 쉽습니다.
#        비밀번호 재설정·이메일 인증이 전부 무용지물이 됩니다.
RESEND_API_KEY=
MAIL_FROM=
APP_BASE_URL=

# [필수] 고객 문의처. 화면과 법적 문서에 표시됩니다.
# ★ .local / .test / example.com 은 메일이 배달되지 않는 예약 도메인입니다.
#   런칭 점검이 거부합니다.
SUPPORT_EMAIL=


# ─────────────────────────────────────────────────────────────────
# 5. 거래소 (KuCoin)
# ─────────────────────────────────────────────────────────────────

# [선택] 엔드포인트. 기본값이 정확하므로 바꿀 이유가 거의 없습니다.
KUCOIN_FUTURES_REST=https://api-futures.kucoin.com
KUCOIN_SPOT_REST=https://api.kucoin.com

# [필수] 운영자 키. ★★ **우리 수익을 확인하는 유일한 수단**입니다.
#        브로커 정산(커미션·리베이트·거래자 목록)을 이 키로 조회합니다.
#        없으면 리베이트가 들어오는지 아닌지 알 방법이 없습니다.
# ★ 사용자 키와 다릅니다. 사용자는 각자 화면에서 자기 키를 등록합니다.
# ★ 이 키에 출금 권한을 주지 마십시오. 조회만 필요합니다.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# [수익] ★★ 브로커 자격증명 3종. **셋 다 있어야** 주문에 서명이 붙습니다.
#        하나라도 없으면 거래는 정상 동작하지만 **리베이트가 0원**입니다.
#        KuCoin 브로커 프로그램 승인 후 발급됩니다.
#        승인 상태는 /admin/fees 에서 확인할 수 있습니다.
KUCOIN_BROKER_PARTNER=
KUCOIN_BROKER_KEY=
KUCOIN_BROKER_NAME=

# [수익] 거래소 가입 추천 링크. 없으면 신규 가입이 우리에게 귀속되지 않습니다.
#        형식: EXCHANGE_REFERRAL_URL_<거래소ID 대문자>
EXCHANGE_REFERRAL_URL_KUCOIN=


# ─────────────────────────────────────────────────────────────────
# 6. 거래 모드 — 실주문을 여는 스위치
# ─────────────────────────────────────────────────────────────────

# 시세 출처. KUCOIN_PUBLIC 은 공개 API 로 실시간 시세를 받습니다.
DATA_MODE=KUCOIN_PUBLIC

# ★★ 실주문을 열려면 **둘 다** 바꿔야 합니다:
#      TRADING_MODE=KUCOIN_LIVE
#      FEATURE_LIVE_ORDERS_ENABLED=true
#    그 뒤에도 킬스위치·리스크 게이트·자격증명 검증을 모두 통과해야 주문이 나갑니다.
#    (게이트 13개 중 하나라도 막히면 전송되지 않고, 화면이 이유를 보여줍니다.)
#
# ★ 실주문을 열기 전에 확인할 것:
#      1. 모의 모드에서 주문 흐름을 끝까지 확인했는가
#      2. 브로커 자격증명이 설정됐는가 (아니면 수익 0원)
#      3. 약관·개인정보가 게시됐는가
#      4. RISK_WATCH_ENABLED 를 함께 켰는가 (청산 경고)
TRADING_MODE=MOCK
FEATURE_LIVE_ORDERS_ENABLED=false


# ─────────────────────────────────────────────────────────────────
# 7. 청산 위험 감시
# ─────────────────────────────────────────────────────────────────

# ★★ 꺼져 있으면 **화면이 열려 있을 때만** 청산 경고가 계산됩니다.
#    사용자가 자는 동안에는 알림이 없습니다.
# ★ 실주문을 여는 시점에 함께 켜십시오.
# ★ 켜면 사용자 포지션을 주기적으로 검사합니다. 대상은 접속한 적 있는
#   사용자뿐입니다(우리 DB 의 포지션을 씁니다).
RISK_WATCH_ENABLED=false

# 검사 주기(ms). 최소 30000 이 강제됩니다.
# ★ 너무 길면 급락 때 경고가 늦습니다 — 선물은 몇 분에 청산까지 갑니다.
RISK_WATCH_INTERVAL_MS=120000


# ─────────────────────────────────────────────────────────────────
# 8. AI (선택)
# ─────────────────────────────────────────────────────────────────

# ★ 연결하지 않으면 AI 분석이 'unavailable' 로 응답합니다. 목업으로 대체하지
#   않으므로 사용자가 잘못된 분석을 받는 일은 없습니다.
# ★ AI 이용권을 포인트로 판매하려면 이것을 먼저 연결하십시오 —
#   실행되지 않는 기능의 이용권을 팔면 안 됩니다.
AI_ENABLED=false
AI_PROVIDER=
OPENAI_SECRET_ARN=
OPENAI_MODEL_PRIMARY=
AWS_REGION=

# 비용 상한. AI 를 켤 때만 의미가 있습니다.
AI_DAILY_USER_BUDGET=
AI_MAX_COST_PER_REQUEST=
AI_RATE_LIMIT_PER_MIN=


# ─────────────────────────────────────────────────────────────────
# 9. 브랜드·표시
# ─────────────────────────────────────────────────────────────────

# 화면·메일·법적 문서에 쓰이는 상호. 코드에 하드코딩하지 않습니다.
BRAND_NAME=ChartControl


# ─────────────────────────────────────────────────────────────────
# 10. 요청 제한 (선택 — 기본값으로 충분)
# ─────────────────────────────────────────────────────────────────

LOGIN_RATE_LIMIT_PER_MIN=
MFA_RATE_LIMIT_PER_MIN=
ADMIN_RATE_LIMIT_PER_MIN=
ORDER_VALIDATE_RATE_LIMIT_PER_MIN=


# ─────────────────────────────────────────────────────────────────
# 11. ★★ 프로덕션에서 반드시 비어 있어야 하는 것
# ─────────────────────────────────────────────────────────────────

# ADMIN_SEED         개발용 관리자 계정을 만듭니다. 프로덕션에서 절대 쓰지 마십시오.
# QT_DEV_SEED_EXT    개발 시드 확장.
# SQLITE_PATH        PostgreSQL 을 쓰면 필요 없습니다.
# BITMART_*          이전 거래소 설정. KuCoin 배포에서는 쓰이지 않습니다.
#
# ★ 개발 계정이 DB 에 남아 있으면 프로덕션 기동이 거부됩니다.
#   `.local` `.test` `example.com` 같은 예약 도메인 계정을 모두 지우십시오.
#   (메일이 배달되지 않는 도메인이므로 실사용자일 수 없습니다.)
