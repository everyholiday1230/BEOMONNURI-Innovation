# ============================================================
# QuantumTrade AI — Environment Variables (EXAMPLE / TEMPLATE)
# Copy to .env and fill values. NEVER commit real secrets.
# All secrets are server-side only. NONE of these are exposed to the browser
# except those explicitly prefixed with VITE_ (which are PUBLIC by definition).
# ============================================================

# ---------- Data mode (drives whole app) ----------
# KUCOIN_PUBLIC | BITMART_PUBLIC | MOCK_REPLAY
#
# KUCOIN_PUBLIC is the production mode. Candles, ticker, order book and trades all come from
# the live KuCoin futures API through one adapter, so no path silently falls back to mock data.
#
# BITMART_PUBLIC is kept for reference only — BitMart stopped trading on 2026-08-26 01:00 UTC.
DATA_MODE=KUCOIN_PUBLIC

# ---------- Trading environment mode ----------
# MOCK | KUCOIN_LIVE | BITMART_DEMO | BITMART_PRODUCTION_DISABLED
# Production is intentionally disabled by default. Do not change without ADR + admin approval.
TRADING_MODE=MOCK
# ---------- Live orders (DANGER: real money) ----------
# Five independent locks must ALL be open before a single order reaches the exchange:
#
#   1. FEATURE_LIVE_ORDERS_ENABLED=true
#   2. TRADING_MODE is one of: KUCOIN_LIVE, BITMART_DEMO
#   3. BITMART_LIVE_TRADING_ENABLED=true AND BITMART_EMERGENCY_KILL_SWITCH=false
#      (these two also gate the KuCoin path — they are the runtime kill switch)
#   4. BITMART_MODE=BITMART_LIVE_TRADE
#
#      ★★ This one was missing from these notes and it is the lock that actually
#         blocks first. Verified by placing a real order: with locks 1-3 open and
#         BITMART_MODE left at its default (BITMART_LIVE_READ_ONLY), the order is
#         refused with "mode does not permit live orders".
#
#      ★ The name says BitMart but it gates the KuCoin path too. It is the
#         deployment's trading posture, not an exchange selector — renaming it
#         would break existing deployments, so it is documented instead.
#
#   5. The user has a VERIFIED exchange API credential
#
# Every risk gate must pass on top of that. The kill switch is checked on EVERY
# order, not at boot, so flipping it stops orders immediately.
#
# Leave this false unless you intend real orders to be placed.
FEATURE_LIVE_ORDERS_ENABLED=false

# ---------- 브로커 자격증명 보관 위치 ----------
#
# 기본값(미설정)은 프로덕션에서 **AWS Secrets Manager 를 요구**한다:
#   BITMART_SECRET_ARN=arn:aws:secretsmanager:...   AWS_REGION=ap-northeast-2
#
# AWS 를 쓰지 않는 배포(Render 등)는 아래를 **직접 적어야** 한다.
#
# ★★ 조건을 "AWS 설정이 없으면 통과" 로 만들지 않았다. 그러면 ARN 을 적는 것을
#   잊은 배포가 조용히 환경변수 경로로 열린다 — 잊은 것과 의도한 것을 구분할 수 없다.
#
# ★ 무엇을 포기하는가
#     · 서버가 침해되면 /proc/<pid>/environ 이나 프로세스 덤프에서 브로커 키가
#       그대로 읽힌다. (Secrets Manager 도 값을 메모리에 올리므로 차이는
#       "환경·디스크에 남는지" 와 "접근 감사 로그" 다.)
#     · 키 회전이 수동이 된다(재배포 필요).
#
# ★ 무엇이 걸려 있는가
#     이 키는 **운영자 브로커 키**다(고객 키는 별개로 DB 에 봉투암호화된다).
#     유출되면 남이 우리 이름으로 주문에 태그를 붙일 수 있지만 **자금을 빼낼 수는
#     없다** — 출금 권한이 없다.
CREDENTIAL_SOURCE=

# ---------- API server ----------
API_PORT=8787
API_HOST=127.0.0.1
# Comma-separated allowlist. No wildcards in production.
# Both dev frontends: apps/web (5173) and apps/broker-web (5174). The origin is checked on password
# reset and on every CSRF-guarded mutation, so a missing entry makes those routes 403 while login and
# register still appear to work.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---------- BitMart PUBLIC endpoints (no auth needed for public market data) ----------
# ---------- KuCoin (current exchange) ----------
KUCOIN_FUTURES_REST=https://api-futures.kucoin.com
KUCOIN_SPOT_REST=https://api.kucoin.com
# Exchange Broker (ND) host. Only used for that contract type; API Broker uses the normal host.
KUCOIN_BROKER_REST=https://api-broker.kucoin.com

# Public REST rate limit. KuCoin documents 12 requests / 2 seconds, so 5 rps leaves headroom.
# Out-of-range values are clamped rather than used, because an IP ban takes the whole service down.
KUCOIN_REST_MAX_RPS=5
KUCOIN_REST_BURST=10

# ---------- KuCoin broker rebate credentials ----------
# Issued by KuCoin after the broker application is approved. All three are required together:
# a partial configuration triggers error 400201, so the partner headers are omitted unless
# every value is present. Without these headers the volume is NOT attributed and no rebate is paid.
#
# NOTE: the contract type (API Broker vs Exchange Broker ND) is still unconfirmed. It changes
# which host and which key flow apply, so confirm it before enabling live orders.
KUCOIN_BROKER_PARTNER=
KUCOIN_BROKER_KEY=
KUCOIN_BROKER_NAME=

# ---------- Market data freshness ----------
# Orders are blocked when market data is stale. Must stay above the KuCoin WS ping interval
# (18s observed), otherwise a healthy idle connection is misreported as stale and orders are
# blocked at random. Values <= 0 fall back to the 30s default instead of blocking forever.
MARKET_STALE_LIMIT_MS=30000

# ---------- BitMart (retained, not in service) ----------
BITMART_REST_BASE=https://api-cloud-v2.bitmart.com
BITMART_WS_PUBLIC=wss://openapi-ws-v2.bitmart.com/api?protocol=1.1

# ---------- BitMart API Broker attribution ----------
# Sent as the X-BM-BROKER-ID header on every signed request so relayed orders are attributed to us
# and rebated (Broker Program, tier Standard). NOT a secret — it travels in a plaintext header.
# Leave blank to use the built-in id from @quantumtrade/config (BITMART_BROKER_ID). Set this only for
# a test or partner account. A blank value falls back to the built-in id rather than disabling
# attribution, because losing attribution raises no error and would silently lose revenue.
BITMART_BROKER_ID=

# ---------- BitMart credentials (NEVER for browser; server-side only) ----------
# Leave blank in Phase 1. Required only for BITMART_DEMO trading adapter (future).
BITMART_API_KEY=
BITMART_API_SECRET=
BITMART_API_MEMO=
# Demo/testnet base (future). Injected via env only.
BITMART_DEMO_REST_BASE=

# ---------- Rate limiting (defaults; tune per BitMart published limits) ----------
BITMART_REST_MAX_RPS=8
BITMART_REST_BURST=15

# ---------- AI orchestrator ----------
# mock | openai-compatible
AI_PROVIDER=mock
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=mock-analyst-v1
AI_MAX_CONCURRENT=4
AI_REQUEST_TIMEOUT_MS=30000
AI_PER_USER_RPM=10

# ---------- Persistence ----------
# PostgreSQL. Set this and the server uses Postgres for identity, user data and
# admin repositories — in development too, not just production.
#
# Why development should also use Postgres: SQLite and Postgres differ in
# concurrent-write locking, type coercion and transaction isolation. If dev runs
# on SQLite, those differences surface for the first time in production, which is
# the latest possible moment to find them.
#
# Leave empty to use the local SQLite file (single-user development only).
# Production REFUSES to start without a postgres:// URL — there is no fallback.
#
# Local development container:
#   docker run -d --name qt-postgres -p 127.0.0.1:15435:5432 \
#     -e POSTGRES_USER=chartcontrol -e POSTGRES_PASSWORD=... \
#     -e POSTGRES_DB=chartcontrol postgres:16-alpine
#
# Apply migrations (11 files, tracked in schema_migrations):
#   cd apps/api && DATABASE_URL=... npx tsx scripts/migrate.ts up
DATABASE_URL=

# Redis/Valkey. Used by the login/MFA rate limiter. Without it the limiter falls
# back to in-process counters, which do not hold across multiple server instances.
REDIS_URL=

# ---------- Auth / sessions (interface-only in Phase 1) ----------
SESSION_SECRET=change-me-in-real-deployments-min-32-chars
COOKIE_DOMAIN=localhost

# ---------- Frontend (VITE_ vars are PUBLIC, shipped to browser) ----------
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_DATA_MODE=MOCK_REPLAY
VITE_DEFAULT_SYMBOL=BTCUSDT

# ---------------------------------------------------------------------------
# Market Data Gateway (apps/market-gateway)
# Browsers connect to THIS, never to BitMart directly: it keeps the exchange
# connection count (500/IP) under our control and no credential reaches a client.
# ---------------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8790
# MOCK_REPLAY (default, no network) | BITMART_PUBLIC (real futures WS)
GATEWAY_UPSTREAM=MOCK_REPLAY
GATEWAY_ORIGIN_ALLOWLIST=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
GATEWAY_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# 3m is intentionally excluded: BitMart has no futures/klineBin3m channel.
GATEWAY_TIMEFRAMES=1m,5m,15m,30m,1h,2h,4h,1d,1w
GATEWAY_MAX_SUBS_PER_USER=20
# Public futures WS + REST. Demo endpoints are rejected fail-closed by ws-config.ts.
BITMART_WS_PUBLIC=wss://openapi-ws-v2.bitmart.com/api?protocol=1.1
# ---------- KuCoin (current exchange) ----------
KUCOIN_FUTURES_REST=https://api-futures.kucoin.com
KUCOIN_SPOT_REST=https://api.kucoin.com
# Exchange Broker (ND) host. Only used for that contract type; API Broker uses the normal host.
KUCOIN_BROKER_REST=https://api-broker.kucoin.com

# Public REST rate limit. KuCoin documents 12 requests / 2 seconds, so 5 rps leaves headroom.
# Out-of-range values are clamped rather than used, because an IP ban takes the whole service down.
KUCOIN_REST_MAX_RPS=5
KUCOIN_REST_BURST=10

# ---------- KuCoin broker rebate credentials ----------
# Issued by KuCoin after the broker application is approved. All three are required together:
# a partial configuration triggers error 400201, so the partner headers are omitted unless
# every value is present. Without these headers the volume is NOT attributed and no rebate is paid.
#
# NOTE: the contract type (API Broker vs Exchange Broker ND) is still unconfirmed. It changes
# which host and which key flow apply, so confirm it before enabling live orders.
KUCOIN_BROKER_PARTNER=
KUCOIN_BROKER_KEY=
KUCOIN_BROKER_NAME=

# ---------- Market data freshness ----------
# Orders are blocked when market data is stale. Must stay above the KuCoin WS ping interval
# (18s observed), otherwise a healthy idle connection is misreported as stale and orders are
# blocked at random. Values <= 0 fall back to the 30s default instead of blocking forever.
MARKET_STALE_LIMIT_MS=30000

# ---------- BitMart (retained, not in service) ----------
BITMART_REST_BASE=https://api-cloud-v2.bitmart.com

# Gateway session auth. The WS handshake carries the session cookie; the gateway validates it against the
# BFF's own GET /auth/me so there is one validation path, not two.
GATEWAY_SESSION_VALIDATE_URL=http://127.0.0.1:8787/api/auth/me
SESSION_COOKIE_NAME=qt_session
# Dev-only escape hatch: accept `?token=user:<id>`. OFF unless explicitly 'true', and ignored in production.
# A query-string token is trusted verbatim and leaks into access logs — never enable this on a shared host.
GATEWAY_DEV_AUTH=false

# ---------------------------------------------------------------------------
# Mail (Resend). Without all three the API falls back to an in-memory sink and
# logs a warning — verification and password-reset links then reach nobody.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender on a domain you own in Resend, e.g. "QuantumTrade <no-reply@yourdomain.com>".
# Resend rejects unverified senders with 422 validation_error.
MAIL_FROM=
# Public base URL of the web app. The verification/reset links are built from this, so a value pointing at
# localhost produces e-mails nobody outside the machine can use.
APP_BASE_URL=http://localhost:5174
MAIL_REPLY_TO=

# ---- KuCoin 레퍼럴 (추천 가입) ----
#
# 브로커 프로그램과 다른 것이다. 혼동하면 수익 계산이 틀린다.
#   레퍼럴 = 이 링크로 신규 가입한 사람의 수수료 일부. API 키 불필요. 즉시 동작.
#   브로커 = 주문에 파트너 헤더를 붙여 받는 리베이트. 자격증명 3종 + 계약 필요.
# 둘은 별개이며 동시에 가질 수 있다.
#
# 우리는 비수탁이므로 사용자가 자기 KuCoin 계정을 만들어야 한다. 계정이 없는
# 사용자에게 이 링크로 가입을 안내한다. 이미 KuCoin 계정이 있는 사람은
# 소급 귀속되지 않는다 — 신규 가입자에게만 의미가 있다.
#
# 비워두면 화면이 가입 유도를 표시하지 않는다.
KUCOIN_REFERRAL_URL=
#
# 링크로 오지 않고 직접 가입하는 사람을 위한 **추천 코드**.
#
# ★ 링크와 코드가 어긋나면 어느 쪽으로 가입했는지에 따라 귀속이 갈린다.
#   같은 계정의 값을 넣어야 한다. 형식은 영숫자와 -_ (2~32자)만 통과한다.
KUCOIN_REFERRAL_CODE=

# ---- 파트너 거래소 레퍼럴 (거래소별) ----
#
# 거래소를 추가할 때 코드를 고치지 않는다. 아래 접두어 규칙으로 넣으면
# 화면의 파트너 거래소 목록에 가입 버튼과 코드가 함께 나타난다.
#
#   EXCHANGE_REFERRAL_URL_<거래소id>=https://...
#   EXCHANGE_REFERRAL_CODE_<거래소id>=CODE
#
# ★ 거래소 id 는 소문자다(kucoin, bitmart …). 화면의 거래소 목록 id 와 같아야
#   연결된다 — 다르면 값이 있는데도 버튼이 나타나지 않는다.
#
# ★★ URL 은 http(s) 만 허용한다. javascript: 를 넣으면 그것이 화면의 링크가
#   되어 클릭 한 번에 실행된다. 잘못된 값은 없는 것으로 처리한다.
#
# ★ 이미 그 거래소 계정이 있는 사람은 소급 귀속되지 않는다 — 신규 가입자에게만
#   의미가 있다. 화면에도 그 사실을 적는다.
EXCHANGE_REFERRAL_URL_BITMART=
EXCHANGE_REFERRAL_CODE_BITMART=

# ---- 서비스 표시 이름 ----
# 화면 전체(제목·헤더·문구)에서 쓰이는 이름. 비워두면 ChartControl.
# 한 곳에서만 정한다 — 이름이 바뀔 때마다 소스 수십 곳을 고치지 않기 위해서다.
BRAND_NAME=ChartControl

# ---- 고객 지원 이메일 ----
# 비워두면 화면이 이메일 문의 경로를 표시하지 않는다.
# 기본값을 두지 않는 이유: 그럴듯한 기본값이 있으면 설정을 잊은 채 배포되고
# 고객 문의가 아무도 받지 않는 주소로 간다.
SUPPORT_EMAIL=

# ---- 공개 접속 주소 ----
# 초대 링크를 만들 때 쓴다. 예: https://chartcontrol.app
# 비워두면 초대 링크를 만들지 않고 코드만 보여준다 — 서버가 자기 주소를
# 추측하면 프록시·개발 주소가 들어가 열리지 않는 링크를 사용자가 공유한다.
PUBLIC_BASE_URL=
