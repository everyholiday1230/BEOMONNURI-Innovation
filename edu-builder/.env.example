# edu-builder 환경설정 예시
# 실제 운영 시 이 파일을 .env 로 복사하고 값을 채우세요.

# ── AI 제공자 ──
# openai  : 실제 ChatGPT API 사용 (OPENAI_API_KEY 필요)
# mock    : 키 없이 규칙 기반으로 동작 (개발/시연용). 키 미설정 시 자동으로 mock.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 인증 ──
# JWT 서명 키. 운영에서는 반드시 긴 무작위 문자열로 교체하세요.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
# 관리자(선생님) 최초 로그인 계정. 최초 기동 시 없으면 생성됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-pw

# ── 저장소 ──
# SQLite 파일 경로. Render 등에서는 영구 디스크 경로로 지정하세요.
DB_PATH=./data/edu.db

# ── 비용 방어 ──
# 학생 1명당 하루 AI 요청 최대 횟수.
STUDENT_DAILY_AI_LIMIT=60

# ── 공개 URL ──
# 작품 공개 링크에 쓰이는 기준 주소.
PUBLIC_BASE_URL=http://localhost:8010
